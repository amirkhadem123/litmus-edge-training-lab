# .env.example — Environment variables for Litmus Lab v4.
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in LITMUS_API_BASE and LITMUS_API_KEY, then start the server:
#     uvicorn app.main:app --reload
#
# SECURITY: Never commit .env to version control. Only .env.example is committed.
# ─────────────────────────────────────────────────────────────────────────────

# Company internal OpenAI-compatible AI API
# Both the customer chat simulation and grading route through this endpoint.
LITMUS_API_BASE=https://ai.internal.yourcompany.com/v1
LITMUS_API_KEY=your-internal-api-key

# Model used for AI customer simulation (conversational, lower stakes).
# Defaults to gpt-4o-mini if not set.
# LITMUS_CHAT_MODEL=gpt-4o-mini

# Model used for grading trainee responses (analytical, structured JSON output).
# Defaults to gpt-4o-mini if not set.
# LITMUS_GRADE_MODEL=gpt-4o-mini

# Data directory — where the SQLite database is stored.
# Set automatically to /data inside Docker. Leave unset for local dev (uses project root).
# LITMUS_DATA_DIR=/data
