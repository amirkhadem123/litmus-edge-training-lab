# .env.example — Environment variables for Litmus Lab v2.
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in the required values, then start the server:
#     uvicorn app.main:app --reload
#
# SECURITY: Never commit .env to version control. Only .env.example is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Admin ─────────────────────────────────────────────────────────────────────
# Password for the /admin page. No admin access if unset.
LITMUS_ADMIN_PASSWORD=change-me-before-deploying

# ── AI provider (server-level fallback) ───────────────────────────────────────
# These are optional company-wide defaults. Any user can override them with their
# own settings at /settings. If set here, new users can run graded checkpoints
# immediately without configuring anything themselves.

LITMUS_API_BASE=https://ai.internal.litmus.io/api
LITMUS_API_KEY=your-internal-api-key

# Provider name shown in the UI preset selector: openwebui | claude | gemini
# LITMUS_PROVIDER=openwebui

# Model used for grading trainee responses.
# LITMUS_GRADE_MODEL=gpt-4o

# ── Proxy (Cloudflare WARP gateway mode only) ─────────────────────────────────
# Most developers do NOT need this. If Cloudflare WARP is running in full tunnel
# mode (the default for most corporate deployments), all traffic is routed through
# the tunnel automatically and this variable should be left unset.
#
# Only set this if WARP is running in gateway/proxy mode. You can tell the
# difference by running: netstat -an | findstr "4000"
#   - Returns nothing  → full tunnel mode → leave this unset
#   - Returns a port   → proxy mode → set this to http://127.0.0.1:<that-port>
#
# Never set this on the production Linux VM (it has direct internal network access).
#
# LITMUS_HTTP_PROXY=http://127.0.0.1:40000

# ── Slack notifications ───────────────────────────────────────────────────────
# When set, posts a message to Slack when a trainee passes a certificate checkpoint.
# Create an incoming webhook at: api.slack.com/apps → your app → Incoming Webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory where the SQLite database file is stored.
# Set automatically to /data inside Docker. Leave unset for local dev.
# LITMUS_DATA_DIR=/data
